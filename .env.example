NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server only. Used for account deletion. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# --- Pre-launch (optional) ---
# soon = everyone sees the coming-soon page. Remove it (or set to "open") on launch day.
LAUNCH_MODE=soon
# Visit https://signedon.social/preview?key=THIS to see the real site yourself (12+ random characters).
PREVIEW_KEY=change-me-to-something-long
# Buttons on the coming-soon page only show when these are set (must start with https://).
DISCORD_URL=
SUPPORT_URL=
# Your fundraiser link, e.g. https://www.gofundme.com/f/latenite-social — shows GoFundMe's live goal/raised widget.
GOFUNDME_URL=
# Countdown target (Eastern time). Default: Mon Jan 4, 2027 at midnight.
LAUNCH_AT=2027-01-04T00:00:00-05:00
SUPPORT_LABEL=Back the project
CONTACT_EMAIL=darrenruth2@gmail.com

# --- Bot protection (Cloudflare Turnstile, free) ---
# 1) Add the SITE key here (and in Vercel) and deploy.  2) THEN turn on CAPTCHA in Supabase → Authentication →
# Attack Protection with the SECRET key. Doing step 2 first would block every login until the site key is live.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- v10.1 (all optional; each feature stays off until its key is set) ---
# Sentinel automatic safety screening — OpenAI moderation (free): platform.openai.com → API keys
OPENAI_API_KEY=
# Profile-song search with autoplay (official music only) — Google Cloud → YouTube Data API v3 → API key
YOUTUBE_API_KEY=
# "Now listening" — last.fm/api/account/create
LASTFM_API_KEY=
# Ideas & questions emailed to you (messages are always saved in /mod) — resend.com
RESEND_API_KEY=
FEEDBACK_EMAIL_TO=
FEEDBACK_EMAIL_FROM=SignedOn <feedback@signedon.social>
